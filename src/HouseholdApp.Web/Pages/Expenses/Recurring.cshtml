@page "/h/{householdId:guid}/Expenses/Recurring"
@model HouseholdApp.Web.Pages.Expenses.RecurringExpensesModel
@using System.Globalization
@{
    ViewData["Title"] = L["Expenses.RecurringHeading"];
}

<div class="page-heading">
    <span>@L["Expenses.RecurringHeading"]</span>
    <a asp-page="Index" asp-route-householdId="@Model.HouseholdId" style="font-family:var(--font-body); font-size:13px; color:var(--text-muted); text-decoration:none; font-weight:500">← @L["Action.Back"]</a>
</div>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" asp-page="Record" asp-route-householdId="@Model.HouseholdId" asp-route-repeat="recurring">+ @L["Action.Create"]</a>
</div>

@if (Model.RecurringExpenses.Count == 0)
{
    <p class="section-title">@L["Common.NoItemsYet"]</p>
}
else
{
    @foreach (var recurring in Model.RecurringExpenses)
    {
        <a asp-page="RecurringDetail" asp-route-householdId="@Model.HouseholdId" asp-route-recurringId="@recurring.Id"
           class="list-row" style="align-items:flex-start; color:inherit; text-decoration:none">
            <div class="list-row-icon" style="background:rgba(59,130,246,0.12)">🔁</div>
            <div class="list-row-body">
                <div class="list-row-name">@recurring.Description</div>
                <div class="list-row-meta">
                    @GroupName(recurring.ExpenseGroupId)
                    · @L[$"Expenses.Frequency.{recurring.Schedule.Frequency}"]
                    · @recurring.Schedule.At(0).ToString("dd MMM yyyy HH:mm", CultureInfo.CurrentCulture) UTC
                </div>
            </div>
            @if (recurring.IsActive)
            {
                <span class="list-row-badge" style="background:rgba(59,130,246,0.12); color:var(--accent-expenses)">@L["Expenses.Active"]</span>
            }
            else
            {
                <span class="list-row-badge" style="background:rgba(74,56,40,0.3); color:var(--text-muted)">@L["Expenses.Recurring.Ended"]</span>
            }
        </a>
    }
}

@functions {
    private string GroupName(Guid id) => Model.GroupNames.GetValueOrDefault(id, "?");
}
