@model HouseholdApp.Web.Pages.Expenses.InstallmentPlanSectionViewModel
@using System.Globalization
@using HouseholdApp.Application.Modules.Expenses.Application.Ports
@{
    var currencySymbol = CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol;
    string Money(long cents) => $"{currencySymbol} {(cents / 100m).ToString("F2")}";
    var slots = Model.Plan.Slots;
    var center = Model.Highlight ?? slots.LastOrDefault(s => s.Status == InstallmentSlotStatus.Created)?.Number ?? 1;
    var fold = Model.Compact && slots.Count > 6;
    var from = fold ? Math.Max(1, center - 1) : 1;
    var through = fold ? Math.Min(slots.Count, center + 1) : slots.Count;
}
<div class="plan-section">
    <div class="plan-section-title">💳 @L["Expenses.Plan.Section", Model.Plan.Count]</div>
    @{
        var hiddenCreated = slots.Where(s => s.Number < from && s.Status == InstallmentSlotStatus.Created).ToList();
        var hiddenVoided = slots.Where(s => s.Number < from && s.Status == InstallmentSlotStatus.Voided).ToList();
        var hiddenUpcoming = slots.Where(s => s.Number > through && s.Status == InstallmentSlotStatus.Upcoming).ToList();
    }
    @if (hiddenCreated.Count == 1)
    {
        <div class="plan-more">✓ @hiddenCreated[0].Number</div>
    }
    else if (hiddenCreated.Count > 1)
    {
        <div class="plan-more">@L["Expenses.Plan.CreatedRange", hiddenCreated[0].Number, hiddenCreated[^1].Number]</div>
    }
    @if (hiddenVoided.Count > 0)
    {
        <div class="plan-more">@L["Expenses.Plan.VoidedRange", hiddenVoided.Count]</div>
    }
    @foreach (var s in slots.Where(s => s.Number >= from && s.Number <= through))
    {
        var (icon, cls) = s.Status switch
        {
            InstallmentSlotStatus.Created => ("✓", "created"),
            InstallmentSlotStatus.Voided => ("✕", "voided"),
            InstallmentSlotStatus.NotCreated => ("–", "not-created"),
            _ => ("○", "upcoming")
        };
        var isHighlight = s.Number == Model.Highlight;
        <div class="plan-slot @cls @(isHighlight ? "current" : "")">
            <span class="plan-slot-icon">@(isHighlight && s.Status == InstallmentSlotStatus.Created ? "●" : icon)</span>
            <span class="plan-slot-date">@s.DueDate.ToString("dd MMM", CultureInfo.CurrentCulture)</span>
            <span>@s.Number/@Model.Plan.Count</span>
            @if (isHighlight)
            {
                <span class="plan-slot-tag">@L[Model.HighlightTagKey]</span>
            }
            @if (s.Status == InstallmentSlotStatus.Voided)
            {
                <span class="plan-slot-tag voided">@L["Expenses.Plan.Tag.Voided"]</span>
            }
            <span class="plan-slot-amount">@Money(s.Cents)</span>
        </div>
    }
    @if (hiddenUpcoming.Count > 0)
    {
        <div class="plan-more">@L["Expenses.Plan.MoreUntil", hiddenUpcoming.Count, hiddenUpcoming[^1].DueDate.ToString("MMM", CultureInfo.CurrentCulture)]</div>
    }
    @if (Model.ShowFooter)
    {
        <div class="plan-totals">
            <span>@L["Expenses.Plan.Totals", Money(Model.Plan.CreatedCents), Money(Model.Plan.RemainingCents)]</span>
            <a class="plan-view-link" href="/h/@Model.HouseholdId/Expenses/Plans/@Model.Plan.PlanId">@L["Expenses.Plan.View"]</a>
        </div>
    }
</div>
