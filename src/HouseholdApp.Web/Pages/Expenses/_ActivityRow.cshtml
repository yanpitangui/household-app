@model HouseholdApp.Application.Modules.Expenses.Application.Ports.ActivityFeedItem
@using System.Globalization
@using HouseholdApp.Application.Modules.Expenses.Infrastructure.Projections
@{
    var currencySymbol = CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol;
    string Money(long? cents) => $"{currencySymbol} {((cents ?? 0) / 100m).ToString("F2")}";
    var settlementAmount = $"{currencySymbol} {((Model.SettlementCents ?? 0) / 100m).ToString("F2")}";
    var text = Model.Kind switch
    {
        ActivityKind.Added => string.Format(L["Expenses.Activity.Added"].Value, Model.ActorDisplayName, Model.Description, Model.GroupName),
        ActivityKind.Edited => string.Format(L["Expenses.Activity.Edited"].Value, Model.ActorDisplayName, Model.Description, Model.GroupName),
        ActivityKind.Removed => string.Format(L["Expenses.Activity.Removed"].Value, Model.ActorDisplayName, Model.Description),
        ActivityKind.RecurringAdded => string.Format(L["Expenses.Activity.RecurringAdded"].Value, Model.ActorDisplayName, Model.Description, Model.GroupName),
        ActivityKind.Settlement => string.Format(L["Expenses.Activity.Settlement"].Value, Model.ActorDisplayName, Model.PayerDisplayName, Model.RecipientDisplayName),
        ActivityKind.HouseholdSettlement => string.Format(L["Expenses.Activity.HouseholdSettlement"].Value,
            Model.ActorDisplayName, Model.PayerDisplayName, Model.RecipientDisplayName, settlementAmount,
            string.Join(", ", Model.GroupNames ?? [])),
        ActivityKind.GroupDeleted => string.Format(L["Expenses.Activity.GroupDeleted"].Value, Model.ActorDisplayName, Model.GroupName),
        ActivityKind.GroupRestored => string.Format(L["Expenses.Activity.GroupRestored"].Value, Model.ActorDisplayName, Model.GroupName),
        ActivityKind.GroupRenamed => string.Format(L["Expenses.Activity.GroupRenamed"].Value, Model.ActorDisplayName, Model.RenamedFrom, Model.RenamedTo),
        ActivityKind.InstallmentPlanCreated => string.Format(L["Expenses.Activity.PlanCreated"].Value,
            Model.ActorDisplayName, Model.Description, Model.GroupName, Model.InstallmentCount, Money(Model.AmountCents)),
        ActivityKind.InstallmentAdded => string.Format(L["Expenses.Activity.InstallmentAdded"].Value,
            Model.ActorDisplayName, Model.Description, Model.GroupName, Model.InstallmentNumber, Model.InstallmentCount,
            Money(Model.AmountCents)),
        ActivityKind.InstallmentPlanPaidEarly => string.Format(L["Expenses.Activity.PlanPaidEarly"].Value,
            Model.ActorDisplayName, Model.Description, Model.InstallmentNumber, Model.InstallmentCount,
            Money(Model.AmountCents), Money(Model.ReferenceCents)),
        ActivityKind.InstallmentPlanCancelled => Model.VoidedCount > 0
            ? string.Format(L["Expenses.Activity.PlanCancelledVoided"].Value, Model.ActorDisplayName, Model.Description, Model.VoidedCount)
            : string.Format(L["Expenses.Activity.PlanCancelled"].Value, Model.ActorDisplayName, Model.Description),
        ActivityKind.InstallmentPlanEdited => string.Format(L["Expenses.Activity.PlanEdited"].Value,
            Model.ActorDisplayName, Model.Description),
        _ => Model.Description
    };
}
<div class="activity-row" data-row>
    <div class="activity-text">
        @if (Model.InstallmentPlanId is { } planLink)
        {
            <a asp-page="/Expenses/Plan" asp-route-householdId="@ViewContext.RouteData.Values["householdId"]" asp-route-planId="@planLink" class="activity-plan-link"><strong>@text</strong></a>
        }
        else
        {
            <strong>@text</strong>
        }
    </div>
    @if (Model.CanRestore && Model.GroupId is { } restoreGroupId)
    {
        <form method="post" asp-page="/Expenses/Activity" asp-page-handler="Restore" asp-route-groupId="@restoreGroupId" class="activity-restore">
            <button type="submit" class="activity-restore-btn">↺ @L["Expenses.Activity.Restore"]</button>
        </form>
    }
    @if (Model.ViewerDeltaCents is { } cents)
    {
        var color = cents >= 0 ? "var(--accent-tasks)" : "#f87171";
        var amount = $"{currencySymbol} {(Math.Abs(cents) / 100m).ToString("F2")}";
        var label = cents >= 0
            ? string.Format(L["Expenses.Activity.YouAreOwed"].Value, amount)
            : string.Format(L["Expenses.Activity.YouOwe"].Value, amount);
        <div class="activity-delta" style="color:@color">@label</div>
    }
    <div class="activity-date">@Model.OccurredAt.ToLocalTime().ToString("d", CultureInfo.CurrentCulture)</div>
</div>
