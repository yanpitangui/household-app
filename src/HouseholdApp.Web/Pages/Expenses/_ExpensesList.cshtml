@model HouseholdApp.Web.Pages.Expenses.ExpensesListViewModel

<div id="expenses-list">
@if (!Model.Entries.Any())
{
    <p class="section-title">@(Model.HasOlder ? L["Expenses.Timeline.AllSettled"] : L["Common.NoItemsYet"])</p>
}
else
{
    @await Html.PartialAsync("~/Pages/Expenses/_ExpenseTimelineRows.cshtml", Model)
}
</div>
