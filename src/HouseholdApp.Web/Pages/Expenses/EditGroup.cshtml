@page "/h/{householdId:guid}/Expenses/Groups/{groupId:guid}/Edit"
@model HouseholdApp.Web.Pages.Expenses.EditExpenseGroupModel
@{
    ViewData["Title"] = L["Expenses.Group.Edit"];
}

<div class="page-heading">
    <span>@L["Expenses.Group.Edit"]</span>
    <a asp-page="Group" asp-route-householdId="@Model.HouseholdId" asp-route-groupId="@Model.GroupId" style="font-family:var(--font-body); font-size:13px; color:var(--text-muted); text-decoration:none; font-weight:500">← @L["Action.Back"]</a>
</div>

<div class="app-card mb-4">
    @await Html.PartialAsync("~/Pages/Expenses/_GroupForm.cshtml", new GroupFormViewModel(Model.Form, L["Action.Save"].Value))
</div>
