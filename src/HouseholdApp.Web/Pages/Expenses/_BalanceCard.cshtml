@model HouseholdApp.Web.Pages.Expenses.BalanceCardViewModel
@using System.Globalization
@{
    var currencySymbol = CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol;
    var nonZeroBalances = Model.Balances.Where(b => b.Cents != 0).ToList();
}

<div id="expenses-balance-card" hx-swap-oob="@(Model.OutOfBand ? "morph" : null)">
@if (nonZeroBalances.Any())
{
    var netCents = Model.Balances.Sum(b => b.Cents);
    var netColor = netCents >= 0 ? "var(--accent-tasks)" : "#f87171";
    var netLabel = netCents >= 0 ? L["Expenses.NetOwed"].Value : L["Expenses.NetOwe"].Value;
    <div class="expenses-balance-card">
        <div class="expenses-balance-eyebrow">
            @(Model.GroupName is null ? L["Expenses.YourBalance"] : L["Expenses.YourBalanceIn", Model.GroupName])
        </div>
        <div class="expenses-balance-net" style="color:@netColor">
            @(netCents >= 0 ? "+" : "−") @currencySymbol @((Math.Abs(netCents) / 100m).ToString("F2"))
        </div>
        <div class="expenses-balance-subtitle" style="color:@netColor">@netLabel</div>
        <div class="expenses-balance-people">
            @foreach (var b in nonZeroBalances)
            {
                var personColor = b.Cents > 0 ? "var(--accent-tasks)" : "#f87171";
                var firstName = NameFormat.First(b.DisplayName);
                var sentence = b.Cents > 0 ? L["Expenses.OwesYouName", firstName].Value : L["Expenses.YouOweName", firstName].Value;
                <div class="expenses-person-row">
                    <span class="payer-init" style="width:22px;height:22px;font-size:9px;border-radius:6px;flex-shrink:0">
                        @if (!string.IsNullOrEmpty(b.PictureUrl))
                        {
                            <img src="@b.PictureUrl" alt="@b.DisplayName" />
                        }
                        else
                        {
                            @(b.DisplayName.Length > 0 ? b.DisplayName[0] : '?')
                        }
                    </span>
                    <span class="expenses-person-name">
                        @sentence
                        <span class="expenses-person-amount" style="color:@personColor">@currencySymbol @((Math.Abs(b.Cents) / 100m).ToString("F2"))</span>
                    </span>
                    <a href="/h/@Model.HouseholdId/expenses/settle?with=@b.UserId@(Model.GroupId is { } g ? $"&group={g}" : "")" class="expenses-settle-with" aria-label="@L["Expenses.SettleWith"] — @sentence">@L["Expenses.SettleWith"]</a>
                </div>
            }
        </div>
    </div>
}
</div>
