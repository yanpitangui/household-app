entity user {}

entity household {
    relation owner  @user;
    relation admin  @user;
    relation member @user;

    permission view               := owner or admin or member;
    permission manage             := owner or admin;
    permission manage_roles       := owner;
    permission edit_settings      := owner or admin;
    permission invite             := owner or admin;
    permission leave              := admin or member;
    permission transfer_ownership := owner;
    permission remove_member      := (owner or admin) and notOwner(context.target_role) and notSelf(context.subject_id, context.target_id);
    permission change_role        := owner and notOwner(context.target_role);
}

fn notOwner(role string) => role != "owner";
fn notSelf(subjectId string, targetId string) => subjectId != targetId;
